  overrides: Partial<SynthesisRequest> = {}
): SynthesisRequest => ({
  text: 'Hello, world!',
  speaker_id: 'speaker_0',
  language_id: 'en',
  format: 'wav',
  speed: 1.0,
  ...overrides,
});

/**
 * Create mock audio generation response
 */
export const createMockAudioGeneration = (
  overrides: Partial<AudioGeneration> = {}
): AudioGeneration => ({
  audio: createMockAudioBlob(),
  mimeType: 'audio/wav',
  ...overrides,
});

