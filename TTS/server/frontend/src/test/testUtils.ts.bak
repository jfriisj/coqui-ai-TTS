/**
 * Test Utilities for Coqui TTS Frontend
 * 
 * Provides React Testing Library utilities, custom render functions, and mock implementations
 * for testing components and hooks throughout the TTS frontend application.
 * 
 * Features:
 * - Custom render function with theme and audio context providers
 * - Mock implementations for API services
 * - Mock audio context and Web Audio API functionality
 * - Test data factories for generating consistent test data
 * - Utility functions for testing async operations
 */

import React, { ReactElement, ReactNode } from 'react';
import { render, RenderOptions } from '@testing-library/react';
import { ThemeProvider } from '../contexts/ThemeContext';
import { AudioProvider } from '../contexts/AudioContext';
import {
  SynthesisRequest,
  AudioGeneration,
  ModelInfo,
  HealthResponse,
  ApiResponse,
  ExtendedModelInfo,
  ThemeConfiguration,
} from '../types/api';

// ===== Test Data Factories =====

/**
 * Create mock audio blob for testing
 */
export const createMockAudioBlob = (
  size: number = 1024,
  type: string = 'audio/wav'
): Blob => {
  const buffer = new ArrayBuffer(size);
  return new Blob([buffer], { type });
};

