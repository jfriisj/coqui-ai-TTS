ARG BASE=nvidia/cuda:13.0.0-base-ubuntu24.04
FROM ${BASE}

# Install OS dependencies:
RUN apt-get update && apt-get upgrade -y
RUN apt-get install -y --no-install-recommends \
    gcc g++ \
    make \
    python3 python3-dev python3-pip python3-venv python3-wheel \
    espeak-ng libsndfile1-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js (for frontend build)
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs

# Install Major Python Dependencies:
RUN pip3 install -U pip "setuptools<81"
RUN pip3 install llvmlite --ignore-installed
RUN pip3 install torch torchaudio --extra-index-url https://download.pytorch.org/whl/cu118
RUN rm -rf /root/.cache/pip

# Copy TTS repository contents:
WORKDIR /root
COPY . /root

# Build frontend
WORKDIR /root/TTS/server/frontend
RUN npm install
RUN npm run build

# Copy built frontend to expected location
WORKDIR /root
RUN mkdir -p static/frontend && \
    cp -r TTS/server/frontend/dist/* static/frontend/

RUN pip3 install -e .[all,dev]

# Set environment variables for non-interactive mode
ENV COQUI_TOS_AGREED=1
ENV PYTHONUNBUFFERED=1
